# --- Telegram ---
# Токен бота от @BotFather (обязателен)
TELEGRAM_BOT_TOKEN=
# Секрет для проверки webhook-запросов от Telegram (обязателен в режиме webhook)
TELEGRAM_WEBHOOK_SECRET=
# Режим работы: polling (локальная разработка) | webhook (прод)
BOT_MODE=polling
# Публичный URL бота (обязателен в режиме webhook), например https://example.vercel.app
PUBLIC_BASE_URL=
WEBHOOK_PATH=/api/telegram/webhook
PORT=3000

# --- Whisper (только Groq Cloud) ---
# Провайдер расшифровки: groq | local (local — заглушка, не реализован)
WHISPER_PROVIDER=groq
# Ключ Groq Cloud (обязателен при WHISPER_PROVIDER=groq): https://console.groq.com
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
# Дополнительные термины для промпта Whisper (через запятую), повышают точность имён/терминов
WHISPER_PROMPT_TERMS=

# --- Лимиты ---
# Максимальная длительность аудио в минутах
MAX_AUDIO_MINUTES=50
# Максимальный размер файла в МБ
MAX_FILE_MB=20
# Время жизни неактивной сессии в минутах
SESSION_TTL_MINUTES=120
# Максимальная доля удалённых символов при очистке (0..1), выше — предупреждение
MAX_REMOVED_RATIO=0.4
# Склейка жёстких переносов: pdf (только для PDF) | all | off
JOIN_HARD_WRAPS=pdf

# --- База данных (Supabase PostgreSQL) ---
# PostgreSQL connection string из Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler для миграций (опционально)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Режимы ---
# Финальный LLM-проход очистки: off | on (по умолчанию on; без ключа бот не стартует)
LLM_VALIDATION=on
# Ключ OpenRouter для финального LLM-прохода: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Порог токенов на один чанк (текст режется, если больше)
LLM_CHUNK_MAX_TOKENS=2500
# Сколько чанков обрабатывать параллельно
LLM_CONCURRENCY=4
# Таймаут одной попытки запроса к модели, мс
LLM_TIMEOUT_MS=35000